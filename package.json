{
  "name": "mahjong",
  "version": "0.1.0",
  "description": "Online Multiplayer Mahjong Game",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check": "node --check src/server.js && node --check src/RoomManager.js && node --check src/MahjongEngine.js && node --check public/js/client.js && node --check public/js/ui.js"
  },
  "keywords": [
    "mahjong",
    "multiplayer",
    "socket.io"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=20"
  }
}
